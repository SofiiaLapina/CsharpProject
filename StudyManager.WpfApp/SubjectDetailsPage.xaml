<Page x:Class="StudyManager.WpfApp.SubjectDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Subject details">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Subject.Name}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding Subject.EctsCredits, StringFormat=ECTS: {0}}"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="2"
                   Text="{Binding Subject.Area, StringFormat=Area: {0}}"
                   Margin="0,0,0,4"/>

        <TextBlock Grid.Row="2"
                   HorizontalAlignment="Right"
                   Text="{Binding Subject.TotalDuration, StringFormat=Total: {0}}"
                   Margin="0,0,0,4"/>

        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Subject.Lessons}"
                 SelectedItem="{Binding SelectedLesson}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Topic}" FontWeight="SemiBold"/>
                        <TextBlock>
                            <Run Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding StartTime, StringFormat={}{0:HH\\:mm}}"/>
                            <Run Text="-"/>
                            <Run Text="{Binding EndTime, StringFormat={}{0:HH\\:mm}}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Type, StringFormat=[{0}] }"/>
                            <Run Text="{Binding Duration, StringFormat=({0})}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Open lesson" Width="120" Margin="0,0,10,0" Command="{Binding OpenLessonCommand}"/>
            <Button Content="Back" Width="80" Command="{Binding BackCommand}"/>
        </StackPanel>
    </Grid>
</Page>