<Page x:Class="StudyManager.WpfApp.SubjectDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Subject Details">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SubjectNameText" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock x:Name="SubjectInfoText" FontSize="14" Margin="0,0,0,10" Grid.Row="1"/>

        <ListBox Grid.Row="2" x:Name="LessonsList" MouseDoubleClick="LessonsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{Binding Date, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                        <TextBlock Text=" | "/>
                        <TextBlock Text="{Binding Topic, Mode=OneWay}"/>
                        <TextBlock Text=" ["/>
                        <TextBlock Text="{Binding Type, Mode=OneWay}"/>
                        <TextBlock Text="]"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="3" Content="Back" Width="100" HorizontalAlignment="Left" Margin="0,10,0,0" Click="BackButton_Click"/>
    </Grid>
</Page>