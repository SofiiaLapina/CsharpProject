<Page x:Class="StudyManager.WpfApp.LessonDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Lesson details">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Lesson.Topic}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding Lesson.Date, StringFormat=Date: {0:yyyy-MM-dd}}"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="2" Margin="0,0,0,6">
            <Run Text="Time: "/>
            <Run Text="{Binding Lesson.StartTime, StringFormat={}{0:HH\\:mm}}"/>
            <Run Text=" - "/>
            <Run Text="{Binding Lesson.EndTime, StringFormat={}{0:HH\\:mm}}"/>
        </TextBlock>

        <TextBlock Grid.Row="3"
                   Text="{Binding Lesson.Type, StringFormat=Type: {0}}"
                   Margin="0,0,0,6"/>

        <TextBlock Grid.Row="4"
                   Text="{Binding Lesson.Duration, StringFormat=Duration: {0}}"
                   Margin="0,0,0,10"/>

        <Button Grid.Row="5"
                Content="Back"
                Width="80"
                HorizontalAlignment="Left"
                Command="{Binding BackCommand}"/>
    </Grid>
</Page>