<Page x:Class="StudyManager.WpfApp.SubjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Subjects">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Subjects"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,12" />

        <Border Grid.Row="1"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Add subject"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Name:" />
                    <TextBox Grid.Column="1"
                             Margin="6,0,12,0"
                             Text="{Binding NewSubjectName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Text="ECTS:" />
                    <TextBox Grid.Column="3"
                             Margin="6,0,12,0"
                             Text="{Binding NewSubjectEctsCredits, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Column="4"
                               VerticalAlignment="Center"
                               Text="Area:" />
                    <ComboBox Grid.Column="5"
                              Margin="6,0,12,0"
                              ItemsSource="{Binding KnowledgeAreas}"
                              SelectedItem="{Binding SelectedKnowledgeArea, Mode=TwoWay}" />

                    <Button Grid.Column="6"
                            Content="Add"
                            Command="{Binding CreateSubjectCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Padding="10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Search:" />
                <TextBox Grid.Column="1"
                         Margin="6,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="Sort:" />
                <ComboBox Grid.Column="3"
                          Margin="6,0,0,0"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}" />
            </Grid>
        </Border>

        <ListBox Grid.Row="3"
                 ItemsSource="{Binding Subjects}"
                 SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                 MouseDoubleClick="SubjectsListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="6">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Id, StringFormat=ID: {0}}" />
                            <TextBlock Text="{Binding EctsCredits, StringFormat=ECTS: {0}}" />
                            <TextBlock Text="{Binding Area, StringFormat=Area: {0}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0">
            <Button Content="Details"
                    Width="120"
                    Margin="0,0,12,0"
                    Command="{Binding OpenSubjectCommand}" />
            <Button Content="Delete"
                    Width="120"
                    Command="{Binding DeleteSubjectCommand}" />
        </StackPanel>

        <Border Grid.RowSpan="5"
                Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Width="220"
                             Height="18"
                             IsIndeterminate="True" />
                <TextBlock Text="Loading..."
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
